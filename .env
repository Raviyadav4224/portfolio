# Copy this file to .env and fill in your own values.
# Vite only exposes env vars prefixed with VITE_ to the browser.

# Google Drive (or any) link to your resume — used by the "Resume" button
VITE_RESUME_LINK=https://drive.google.com/file/d/your-file-id/view

# EmailJS credentials for the Contact form — https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=service_t6abukk
VITE_EMAILJS_TEMPLATE_ID=template_6xf8nmk
